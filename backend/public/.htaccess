Options -Indexes -MultiViews
DirectoryIndex index.html

RewriteEngine On

# The reading material now lives in the gallery.
RewriteRule ^(?:health-library|blogs)(?:\.html)?/?$ /gallery#gallery-learning-title [R=301,L,NE]

# Redirect old public page URLs to the clean URL. THE_REQUEST avoids loops
# when the clean URL is internally served by its .html file.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+[a-z0-9-]+\.html(?:[?\s]) [NC]
RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L]

RewriteRule ^index/?$ / [R=301,L]

# Canonicalise trailing slashes for pages, leaving real directories alone.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]

# Keep assets, PHP endpoints, and the staff directory unchanged.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]

<FilesMatch "\.(sql|example|log|ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set X-Frame-Options "DENY"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
 Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
<FilesMatch "(^\.|\.(env|bak|backup|sqlite|key|pem)$|^config\.php$)">
 Require all denied
</FilesMatch>
