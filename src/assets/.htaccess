# Public assets only. Booking API and staff pages keep their no-store policy.
<IfModule mod_headers.c>
 Header set Cache-Control "public, max-age=604800"
 <FilesMatch "-[a-f0-9]{10}\.webp$">
  Header set Cache-Control "public, max-age=31536000, immutable"
 </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>
AddType image/webp .webp
AddType font/woff2 .woff2
